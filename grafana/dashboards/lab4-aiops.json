{
 "uid": "lab4-aiops",
 "title": "Lab 4 — AIOps y SLOs (data-service)",
 "description": "Módulo B y D: detección de anomalías correlacionada, SLOs y error budget",
 "tags": [
  "lab4"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Error rate de data-service vs banda dinámica (μ + 2σ)",
   "description": "",
   "datasource": "Prometheus",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "data_service:error_ratio:rate1m",
     "legendFormat": "error rate"
    },
    {
     "refId": "B",
     "expr": "data_service:error_ratio:upper_band",
     "legendFormat": "umbral dinámico μ+2σ"
    },
    {
     "refId": "C",
     "expr": "data_service:error_ratio:baseline_avg",
     "legendFormat": "baseline μ (15 min)"
    },
    {
     "refId": "D",
     "expr": "vector(0.01)",
     "legendFormat": "umbral estático 1 %"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Latencia p99 de data-service vs SLO (300 ms)",
   "description": "",
   "datasource": "Prometheus",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      },
      "thresholdsStyle": {
       "mode": "line+area"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 0.3
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
