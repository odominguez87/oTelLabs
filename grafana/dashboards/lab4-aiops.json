   "title": "Logs de error de data-service (Loki · OTLP, con trace_id)",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 24,
    "h": 9
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "enableLogDetails": true,
    "sortOrder": "Descending",
    "showLabels": false,
    "dedupStrategy": "none"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{service_name=\"data-service\"} | severity_text=\"ERROR\" | line_format \"trace_id={{.trace_id}} {{__line__}}\"",
