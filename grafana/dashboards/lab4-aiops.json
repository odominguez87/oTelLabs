     "legendFormat": "p99"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Notificaciones de alerta acumuladas: estáticas vs AIOps",
   "description": "Cada punto = notificaciones 'firing' recibidas por el alert-enricher",
   "datasource": "Prometheus",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (kind)(enriched_alerts_total{kind=~\"static|aiops\"})",
     "legendFormat": "{{kind}}"
    }
