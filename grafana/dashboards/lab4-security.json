   "targets": [
    {
     "refId": "A",
     "expr": "sum by (envoy_response_code)(rate(envoy_cluster_upstream_rq{envoy_cluster_name=\"data_service\"}[1m]))",
     "legendFormat": "HTTP {{envoy_response_code}}"
    }
   ]
  },
