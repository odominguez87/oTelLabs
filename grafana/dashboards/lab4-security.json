  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Intentos de autenticación fallidos por motivo (por minuto)",
   "description": "",
   "datasource": "Prometheus",
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (reason)(rate(otelcol_data_service_auth_failures_total[1m])) * 60",
     "legendFormat": "{{reason}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Tráfico Norte-Sur vs Este-Oeste (rps)",
   "description": "N-S desde las métricas de service-a; E-W desde el sidecar Envoy (L7)",
   "datasource": "Prometheus",
   "gridPos": {
    "x": 12,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "network:north_south_rps",
     "legendFormat": "N-S: clientes → service-a"
    },
    {
     "refId": "B",
     "expr": "network:east_west_rps",
     "legendFormat": "E-W: service-a → data-service (mesh)"
    },
    {
     "refId": "C",
     "expr": "sum(rate(otelcol_data_service_requests_total{via_mesh=\"false\"}[1m]))",
     "legendFormat": "E-W fuera del mesh"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "E-W por código de respuesta (Envoy L7)",
