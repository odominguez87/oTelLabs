{
 "uid": "lab4-security",
 "title": "Lab 4 — Golden Signals de Seguridad",
 "description": "Módulo C: autenticación fallida, tráfico N-S/E-W y CVEs activos",
 "tags": [
  "lab4"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Auth fallidas / min (máx. en la ventana)",
   "description": "Intentos de autenticación fallidos en data-service (API key ausente o inválida)",
   "datasource": "Prometheus",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 10
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "max"
     ]
    },
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "value"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "security:auth_failures:rate1m",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Tráfico fuera del mesh (rps, máx.)",
   "description": "Requests que llegan a data-service sin pasar por su sidecar Envoy (bypass)",
   "datasource": "Prometheus",
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 0.0001
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "max"
     ]
    },
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "value"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(otelcol_data_service_requests_total{via_mesh=\"false\"}[1m])) or vector(0)",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "CVEs CRITICAL activos",
